log_level=3
stderror_enabled=no
syslog_enabled=yes
syslog_facility=LOG_LOCAL0

mpath="/usr/lib/x86_64-linux-gnu/opensips/modules/"
auto_aliases=no
udp_workers=4
socket=udp:10.128.0.4:5060 as 34.172.210.177

loadmodule "signaling.so"
loadmodule "sl.so"
loadmodule "tm.so"
loadmodule "rr.so"
loadmodule "maxfwd.so"
loadmodule "sipmsgops.so"
loadmodule "textops.so"
loadmodule "dialog.so"
loadmodule "mi_fifo.so"
loadmodule "pike.so"
loadmodule "nathelper.so"
loadmodule "proto_udp.so"
loadmodule "rtpengine.so"
loadmodule "usrloc.so"
loadmodule "registrar.so"

modparam("mi_fifo", "fifo_name", "/tmp/opensips_fifo")
modparam("rtpengine", "rtpengine_sock", "udp:127.0.0.1:2223")
modparam("usrloc", "db_mode", 0)
modparam("registrar", "default_expires", 3600)
modparam("rr", "append_fromtag", 1)
modparam("pike", "sampling_time_unit", 2)
modparam("pike", "reqs_density_per_unit", 30)
modparam("nathelper", "natping_interval", 30)
modparam("dialog", "default_timeout", 21600)
modparam("tm", "fr_timeout", 30)
modparam("tm", "fr_inv_timeout", 120)

route {
    if (!mf_process_maxfwd_header(10)) {
        sl_send_reply(483, "Too Many Hops");
        exit;
    }

    if (is_method("OPTIONS")) {
        sl_send_reply(200, "OK");
        exit;
    }

    if (!pike_check_req()) {
        xlog("L_WARN", "PIKE blocking $si\n");
        exit;
    }

    if (has_totag()) {
        if (loose_route()) {
            xlog("L_INFO", "Sequential request - loose routing\n");
            if (is_method("BYE")) {
                rtpengine_delete();
            }
            route(RELAY);
            exit;
        } else {
            if (is_method("ACK")) {
                if (t_check_trans()) {
                    xlog("L_INFO", "ACK for transaction\n");
                    t_relay();
                    exit;
                }
            }
            sl_send_reply(404, "Not Here");
            exit;
        }
    }

    if (is_method("CANCEL")) {
        if (t_check_trans()) {
            t_relay();
        }
        exit;
    }

    t_check_trans();

    if (is_method("REGISTER")) {
        xlog("L_INFO", "REGISTER from $fu\n");
        fix_nated_contact();
        if (!save("location")) {
            sl_reply_error();
        }
        exit;
    }

    if (is_method("INVITE")) {
        xlog("L_INFO", "INVITE from $fu to $rU\n");
        record_route();
        fix_nated_contact();
        create_dialog();
        t_on_failure("1");
        t_on_reply("1");
        
        if ($rU =~ "^\*9[78]" || $rU =~ "^9[16][0-9]{2}" || $rU =~ "^9888" || 
            $rU =~ "^3[0-9]{3}" || $rU =~ "^5[0-9]{3}") {
            xlog("L_INFO", "Route to FreeSWITCH $rU\n");
            route(TO_FREESWITCH);
            exit;
        }
        
        if (lookup("location")) {
            xlog("L_INFO", "Route to user\n");
            route(RELAY);
            exit;
        }
        
        xlog("L_INFO", "Default to FreeSWITCH\n");
        route(TO_FREESWITCH);
        exit;
    }

    route(RELAY);
}

route[TO_FREESWITCH] {
    xlog("L_INFO", "Forward to FS $ru\n");
    $du = "sip:10.128.0.4:5080";
    
    if (has_body("application/sdp")) {
        rtpengine_offer("replace-origin replace-session-connection ICE=remove RTP/AVP internal external");
    }
    
    if (!t_relay()) {
        sl_reply_error();
    }
    exit;
}

route[RELAY] {
    if (has_body("application/sdp")) {
        rtpengine_offer("replace-origin replace-session-connection ICE=remove RTP/AVP internal external");
    }
    
    if (!t_relay()) {
        sl_reply_error();
    }
    exit;
}

onreply_route[1] {
    xlog("L_INFO", "Reply $rs from $si\n");
    
    if (has_body("application/sdp")) {
        rtpengine_answer("replace-origin replace-session-connection ICE=remove RTP/AVP external internal");
    }
    
    #fix_nated_contact();
}

failure_route[1] {
    xlog("L_WARN", "CALL_FAILURE code=$T_reply_code from=$fu to=$ru callid=$ci\n");
    
    if (t_check_status("403")) {
        xlog("L_WARN", "FAILURE_403_FORBIDDEN from=$fu to=$ru callid=$ci\n");
    } else if (t_check_status("404")) {
        xlog("L_WARN", "FAILURE_404_NOT_FOUND from=$fu to=$ru callid=$ci\n");
    } else if (t_check_status("408")) {
        xlog("L_WARN", "FAILURE_408_TIMEOUT from=$fu to=$ru callid=$ci\n");
    } else if (t_check_status("480")) {
        xlog("L_WARN", "FAILURE_480_UNAVAILABLE from=$fu to=$ru callid=$ci\n");
    } else if (t_check_status("486")) {
        xlog("L_WARN", "FAILURE_486_BUSY from=$fu to=$ru callid=$ci\n");
    } else if (t_check_status("500")) {
        xlog("L_WARN", "FAILURE_500_SERVER_ERROR from=$fu to=$ru callid=$ci\n");
    } else if (t_check_status("503")) {
        xlog("L_WARN", "FAILURE_503_UNAVAILABLE from=$fu to=$ru callid=$ci\n");
    }
}

#
# OpenSIPS SBC Configuration
# Production-quality Session Border Controller
# Handles signaling, NAT, media relay, DoS protection
#

####### Global Parameters #########

log_level=3
log_stderror=yes
log_facility=LOG_LOCAL0

children=4
disable_tcp=yes
disable_tls=yes

auto_aliases=no

listen=udp:10.128.0.4:5060 as 34.172.210.177:5060

####### Modules Section ########

# Core modules
loadmodule "signaling.so"
loadmodule "sl.so"
loadmodule "tm.so"
loadmodule "rr.so"
loadmodule "maxfwd.so"
loadmodule "sipmsgops.so"
loadmodule "textops.so"
loadmodule "mi_fifo.so"
loadmodule "proto_udp.so"

# SBC-specific modules
loadmodule "dialog.so"
loadmodule "nathelper.so"
loadmodule "rtpengine.so"
loadmodule "pike.so"

# User location (for REGISTER)
loadmodule "usrloc.so"
loadmodule "registrar.so"

####### Module Parameters #########

# MI FIFO
modparam("mi_fifo", "fifo_name", "/tmp/opensips_fifo")

# Record-Route
modparam("rr", "append_fromtag", 1)
modparam("rr", "enable_double_rr", 0)

# Transaction Module
modparam("tm", "fr_timeout", 30)
modparam("tm", "fr_inv_timeout", 120)
modparam("tm", "restart_fr_on_each_reply", 0)

# Dialog Module - Stateful Call Tracking
modparam("dialog", "default_timeout", 21600)
modparam("dialog", "dlg_match_mode", 1)
modparam("dialog", "db_mode", 0)
modparam("dialog", "profiles_with_value", "caller")

# Pike - DoS Protection
modparam("pike", "sampling_time_unit", 10)
modparam("pike", "reqs_density_per_unit", 100)
modparam("pike", "remove_latency", 120)

# NAT Helper
modparam("nathelper", "natping_interval", 30)
modparam("nathelper", "ping_nated_only", 1)
modparam("nathelper", "received_avp", "$avp(received)")

# RTPEngine - Media Relay
modparam("rtpengine", "rtpengine_sock", "udp:127.0.0.1:2223")

# User Location
modparam("usrloc", "db_mode", 0)
modparam("usrloc", "nat_bflag", "NAT")

# Registrar
modparam("registrar", "default_expires", 3600)
modparam("registrar", "max_expires", 7200)
modparam("registrar", "min_expires", 60)

####### Routing Logic ########

route {
    
    # ================================================================
    # SANITY CHECKS
    # ================================================================
    
    # Max-Forwards check
    if (!mf_process_maxfwd_header("10")) {
        sl_send_reply("483", "Too Many Hops");
        exit;
    }
    
    # Sanity check for malformed messages
    if ($ua == "") {
        sl_send_reply("400", "Bad Request - No User-Agent");
        exit;
    }
    
    # ================================================================
    # OPTIONS - Health Check
    # ================================================================
    
    if (is_method("OPTIONS")) {
        sl_send_reply("200", "OK");
        exit;
    }
    
    # ================================================================
    # PIKE DoS PROTECTION (with whitelist)
    # ================================================================
    
    # Whitelist trusted sources
    if ($si == "4.235.114.198" ||    # Azure SIPP public
        $si == "10.0.0.4" ||         # Azure private
        $si == "34.172.210.177" ||   # GCP public (self)
        $si == "10.128.0.4" ||       # GCP private (self)
        $si == "127.0.0.1") {        # Localhost
        # Whitelisted - skip Pike
    } else {
        # Apply Pike rate limiting
        if (!pike_check_req()) {
            xlog("L_WARN", "PIKE: Blocking $si - too many requests\n");
            exit;
        }
    }
    
    # ================================================================
    # SEQUENTIAL (IN-DIALOG) REQUESTS
    # ================================================================
    
    if (has_totag()) {
        
        # Standard Route header processing
        if (loose_route()) {
            xlog("L_INFO", "Sequential $rm via Route header\n");
            
            if (is_method("BYE")) {
                setflag(1); # CDR flag
                xlog("L_INFO", "BYE received - terminating call\n");
                rtpengine_delete();
            } else if (is_method("INVITE")) {
                xlog("L_INFO", "re-INVITE - updating session\n");
                record_route();
            }
            
            route(relay);
            exit;
        }
        
        # No Route header - try dialog matching
        if (match_dialog()) {
            xlog("L_INFO", "Sequential $rm matched via dialog\n");
            
            if (is_method("ACK")) {
                xlog("L_INFO", "ACK for 200 OK - dialog matched\n");
                route(relay);
                exit;
            }
            
            if (is_method("BYE")) {
                setflag(1);
                xlog("L_INFO", "BYE via dialog match\n");
                rtpengine_delete();
                route(relay);
                exit;
            }
            
            # Other in-dialog requests
            route(relay);
            exit;
        }
        
        # ACK without Route or Dialog - check transaction
        if (is_method("ACK")) {
            if (t_check_trans()) {
                xlog("L_INFO", "ACK for negative response\n");
                route(relay);
                exit;
            }
            # Absorb ACK without match
            xlog("L_WARN", "ACK without matching transaction/dialog - dropping\n");
            exit;
        }
        
        # Sequential request with no routing info
        xlog("L_ERR", "Sequential $rm without Route or Dialog match\n");
        sl_send_reply("404", "Not Here");
        exit;
    }
    
    # ================================================================
    # INITIAL REQUESTS (No To-tag)
    # ================================================================
    
    # Preloaded Route headers
    remove_hf("Route");
    
    # CANCEL processing
    if (is_method("CANCEL")) {
        if (t_check_trans()) {
            route(relay);
        }
        exit;
    }
    
    # Absorb retransmissions
    t_check_trans();
    
    # ================================================================
    # REGISTER
    # ================================================================
    
    if (is_method("REGISTER")) {
        xlog("L_INFO", "REGISTER from $fu\n");
        
        # NAT detection
        if (nat_uac_test("19")) {
            setflag(NAT);
            fix_nated_register();
        }
        
        if (!save("location")) {
            xlog("L_ERR", "REGISTER failed for $fu\n");
            sl_reply_error();
        }
        exit;
    }
    
    # ================================================================
    # INVITE - New Call
    # ================================================================
    
    if (is_method("INVITE")) {
        xlog("L_INFO", "New INVITE: $fu -> $ru\n");
        
        # NAT detection
        if (nat_uac_test("19")) {
            setflag(NAT);
        }
        
        # Record-Route for proper in-dialog routing
        record_route();
        
        # Create stateful dialog
        create_dialog();
        
        # Set reply route for NAT and media handling
        t_on_reply("handle_nat_reply");
        t_on_failure("missed_call");
        
        # Route to backend (FreeSWITCH)
        route(to_freeswitch);
        exit;
    }
    
    # ================================================================
    # OTHER REQUESTS
    # ================================================================
    
    xlog("L_INFO", "Other request: $rm from $fu\n");
    route(relay);
}

####### Helper Routes ########

# Route to FreeSWITCH backend
route[to_freeswitch] {
    xlog("L_INFO", "Routing to FreeSWITCH: $rU\n");
    
    # Set destination
    $du = "sip:10.128.0.4:5080";
    
    # NAT handling
    if (isflagset(NAT)) {
        fix_nated_contact();
    }
    
    # Engage RTPEngine for media relay
    if (has_body("application/sdp")) {
        xlog("L_INFO", "Engaging RTPEngine for media relay\n");
        rtpengine_offer("replace-origin replace-session-connection ICE=remove RTP/AVP internal external");
    }
    
    if (!t_relay()) {
        sl_reply_error();
    }
}

# Standard relay
route[relay] {
    if (!t_relay()) {
        sl_reply_error();
    }
    exit;
}

####### Reply Routes ########

onreply_route[handle_nat_reply] {
    xlog("L_INFO", "Reply: $rs $rr\n");
    
    # NAT handling for replies
    if (isflagset(NAT)) {
        fix_nated_contact();
    }
    
    # RTPEngine answer processing
    if (has_body("application/sdp")) {
        xlog("L_INFO", "Processing SDP in reply\n");
        rtpengine_answer("replace-origin replace-session-connection ICE=remove RTP/AVP external internal");
    }
}

####### Failure Routes ########

failure_route[missed_call] {
    if (t_was_cancelled()) {
        xlog("L_INFO", "Call was cancelled\n");
        exit;
    }
    
    xlog("L_WARN", "Call failed: $T_reply_code\n");
    
    # Could add voicemail, alternate routing, etc.
}


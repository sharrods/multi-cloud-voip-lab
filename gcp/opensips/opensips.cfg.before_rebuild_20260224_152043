#
# OpenSIPS SBC Configuration
# Handles signaling between external clients and FreeSWITCH
#

log_level=4
stderror_enabled=yes
syslog_enabled=no

mpath="/usr/lib/x86_64-linux-gnu/opensips/modules/"
auto_aliases=no
udp_workers=4

# Listen on private IP, advertise public IP
socket=udp:10.128.0.4:5060 as 34.172.210.177

# ===================================================================
# MODULES
# ===================================================================
loadmodule "signaling.so"
loadmodule "sl.so"
loadmodule "tm.so"
loadmodule "rr.so"
loadmodule "maxfwd.so"
loadmodule "sipmsgops.so"
loadmodule "textops.so"
loadmodule "dialog.so"
loadmodule "mi_fifo.so"
loadmodule "pike.so"
loadmodule "nathelper.so"
loadmodule "proto_udp.so"
loadmodule "rtpengine.so"
loadmodule "usrloc.so"
loadmodule "registrar.so"

# ===================================================================
# MODULE PARAMETERS
# ===================================================================

# Management Interface
modparam("mi_fifo", "fifo_name", "/tmp/opensips_fifo")

# RTPEngine - media relay
modparam("rtpengine", "rtpengine_sock", "udp:127.0.0.1:2223")

# User Location
modparam("usrloc", "db_mode", 0)
modparam("registrar", "default_expires", 3600)

# Record-Route
modparam("rr", "append_fromtag", 1)

# Pike - DoS protection
modparam("pike", "sampling_time_unit", 2)
modparam("pike", "reqs_density_per_unit", 30)

# NAT Helper
modparam("nathelper", "natping_interval", 30)

# Dialog - stateful call tracking
modparam("dialog", "default_timeout", 21600)
modparam("dialog", "dlg_match_mode", 1)
modparam("dialog", "db_mode", 0)

# Transaction Module
modparam("tm", "fr_timeout", 30)
modparam("tm", "fr_inv_timeout", 120)

# ===================================================================
# MAIN ROUTING LOGIC
# ===================================================================

route {
    
    # ---------------------------------------------------------------
    # Sanity Checks
    # ---------------------------------------------------------------
    
    if (!mf_process_maxfwd_header(10)) {
        sl_send_reply(483, "Too Many Hops");
        exit;
    }

    if (is_method("OPTIONS")) {
        sl_send_reply(200, "OK");
        exit;
    }


    # --------------------------------------------------------------
    # Whittelist based on actual source IP
    # --------------------------------------------------------------
    xlog("L_INFO", "Request from source IP: $si\n");

    if ($si == "4.235.114.198" || $si == "10.0.0.4") {
	xlog("L_INFO", "SIPP client whitelisted from Pike\n");
    } else if ($si == "10.128.0.4" || $si == "34.172.210.177") {
	xlog("L_INFO", "Internal/self traffic whitelisted from Pike\n");
    } else {
	if (!pike_check_req()) {
	    xlog("L_WARN", "PIKE: Blocking $si\n");
	    exit;
	}
    }
    # ---------------------------------------------------------------
    # IN-DIALOG REQUESTS (Sequential Requests)
    # ---------------------------------------------------------------
    
    if (has_totag()) {
        
        # Standard loose routing (requests with Route header)
        if (loose_route()) {
            xlog("L_INFO", "In-dialog $rm via loose_route\n");
            
            if (is_method("BYE")) {
                xlog("L_INFO", "BYE: Deleting media session\n");
                rtpengine_delete();
            } else if (is_method("INVITE")) {
                xlog("L_INFO", "re-INVITE: Updating media\n");
                record_route();
            }
            
            route(RELAY);
            exit;
        }
        
        # No Route header - use dialog matching
        # This handles ACK for 200 OK and malformed BYEs
        if (match_dialog()) {
            xlog("L_INFO", "In-dialog $rm matched via dialog\n");
            
            if (is_method("ACK")) {
                xlog("L_INFO", "ACK: Matched dialog, relaying\n");
                route(RELAY);
                exit;
            }
            
            if (is_method("BYE")) {
                xlog("L_INFO", "BYE: Matched dialog, deleting media\n");
                rtpengine_delete();
                route(RELAY);
                exit;
            }
            
            # Other in-dialog requests
            route(RELAY);
            exit;
        }
        

      # ACK without Route or Dialog - check transaction
        if (is_method("ACK")) {
            if (t_check_trans()) {
                xlog("L_INFO", "ACK: Transaction match, forwarding to FreeSWITCH\n");
        
                # Set destination to FreeSWITCH
                $du = "sip:10.128.0.4:5080";
                $ru = "sip:" + $rU + "@10.128.0.4:5080";
        
                route(RELAY);
                exit;
            } else {
                xlog("L_WARN", "ACK: No route, no dialog, no transaction - dropping\n");
                exit;
            }
         }


        # Sequential request without proper routing
        xlog("L_ERR", "Sequential $rm: No route and no dialog match\n");
        sl_send_reply(404, "Not Here");
        exit;
    }

    # ---------------------------------------------------------------
    # INITIAL REQUESTS (No To-tag)
    # ---------------------------------------------------------------
    
    # Remove any pre-existing Route headers on initial requests
    remove_hf("Route");
    
    if (is_method("CANCEL")) {
        if (t_check_trans()) {
            route(RELAY);
        }
        exit;
    }

    # Transaction matching for retransmissions
    t_check_trans();

    # ---------------------------------------------------------------
    # REGISTER
    # ---------------------------------------------------------------
    
    if (is_method("REGISTER")) {
        xlog("L_INFO", "REGISTER: $fu\n");
        
        fix_nated_contact();
        
        if (!save("location")) {
            xlog("L_ERR", "REGISTER: Failed to save location\n");
            sl_reply_error();
        }
        exit;
    }

    # ---------------------------------------------------------------
    # INVITE - New Call
    # ---------------------------------------------------------------
    
    if (is_method("INVITE")) {
        xlog("L_INFO", "INVITE: $fu -> $rU\n");
        
        # Add Record-Route for proper routing of in-dialog requests
        record_route();
        
        # Create dialog for stateful tracking
        create_dialog();
        
        # NAT handling
        fix_nated_contact();
        
        # Set transaction callbacks
        t_on_failure("CALL_FAILED");
        t_on_reply("HANDLE_REPLY");
        
        # Route to backend (FreeSWITCH)
        route(TO_BACKEND);
        exit;
    }

    # ---------------------------------------------------------------
    # Other Initial Requests
    # ---------------------------------------------------------------
    
    xlog("L_INFO", "Other initial request: $rm\n");
    route(RELAY);
}

# ===================================================================
# ROUTE TO BACKEND (FreeSWITCH)
# ===================================================================

route[TO_BACKEND] {
    xlog("L_INFO", "Routing to FreeSWITCH: $rU\n");
    
    # Set destination
    $du = "sip:10.128.0.4:5080";
    $ru = "sip:" + $rU + "@10.128.0.4:5080";
    
    # Engage RTPEngine for media relay
    if (has_body("application/sdp")) {
        xlog("L_INFO", "Engaging RTPEngine (offer)\n");
        rtpengine_offer("replace-origin replace-session-connection ICE=remove RTP/AVP internal external");
    }
    
    route(RELAY);
}

# ===================================================================
# RELAY
# ===================================================================

route[RELAY] {
    
    if (!t_relay()) {
        xlog("L_ERR", "RELAY: t_relay failed for $rm\n");
        sl_reply_error();
    }
    exit;
}

# ===================================================================
# REPLY HANDLING
# ===================================================================

onreply_route[HANDLE_REPLY] {
    xlog("L_INFO", "Reply: $rs $rr for $rm\n");
    
    # Handle SDP in replies
    if (has_body("application/sdp")) {
        xlog("L_INFO", "Engaging RTPEngine (answer)\n");
        rtpengine_answer("replace-origin replace-session-connection ICE=remove RTP/AVP external internal");
    }
}

# ===================================================================
# FAILURE HANDLING
# ===================================================================

failure_route[CALL_FAILED] {
    xlog("L_WARN", "Call failed: $T_reply_code from $fu to $rU\n");
    
    # Could add fallback routing, voicemail, etc here
}

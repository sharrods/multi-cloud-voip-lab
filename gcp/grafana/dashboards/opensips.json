{
  "id": null,
  "uid": "opensips-sbc",
  "title": "OpenSIPS SBC Monitoring",
  "tags": ["opensips", "voip", "sbc"],
  "timezone": "browser",
  "schemaVersion": 27,
  "version": 0,
  "refresh": "5s",
  "panels": [
    {
      "type": "stat",
      "title": "OpenSIPS Status",
      "gridPos": {"h": 4, "w": 4, "x": 0, "y": 0},
      "targets": [{"expr": "opensips_up", "refId": "A"}],
      "fieldConfig": {
        "defaults": {
          "mappings": [
            {"options": {"0": {"text": "Down", "color": "red"}}, "type": "value"},
            {"options": {"1": {"text": "Up", "color": "green"}}, "type": "value"}
          ],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {"value": 0, "color": "red"},
              {"value": 1, "color": "green"}
            ]
          }
        }
      }
    },
    {
      "type": "stat",
      "title": "Active Dialogs",
      "gridPos": {"h": 4, "w": 4, "x": 4, "y": 0},
      "targets": [{"expr": "opensips_active_dialogs", "refId": "A"}],
      "fieldConfig": {
        "defaults": {
          "color": {"mode": "thresholds"},
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {"value": 0, "color": "blue"},
              {"value": 10, "color": "yellow"},
              {"value": 50, "color": "red"}
            ]
          }
        }
      }
    },
    {
      "type": "stat",
      "title": "Total Registrations",
      "gridPos": {"h": 4, "w": 4, "x": 8, "y": 0},
      "targets": [{"expr": "opensips_registrations_total", "refId": "A"}]
    },
    {
      "type": "stat",
      "title": "Redis Status",
      "gridPos": {"h": 4, "w": 4, "x": 12, "y": 0},
      "targets": [{"expr": "redis_up", "refId": "A"}],
      "fieldConfig": {
        "defaults": {
          "mappings": [
            {"options": {"0": {"text": "Down", "color": "red"}}, "type": "value"},
            {"options": {"1": {"text": "Up", "color": "green"}}, "type": "value"}
          ],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {"value": 0, "color": "red"},
              {"value": 1, "color": "green"}
            ]
          }
        }
      }
    },
    {
      "type": "stat",
      "title": "RTPEngine Status",
      "gridPos": {"h": 4, "w": 4, "x": 16, "y": 0},
      "targets": [{"expr": "rtpengine_up", "refId": "A"}],
      "fieldConfig": {
        "defaults": {
          "mappings": [
            {"options": {"0": {"text": "Down", "color": "red"}}, "type": "value"},
            {"options": {"1": {"text": "Up", "color": "green"}}, "type": "value"}
          ],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {"value": 0, "color": "red"},
              {"value": 1, "color": "green"}
            ]
          }
        }
      }
    },
    {
      "type": "graph",
      "title": "SIP INVITE Rate",
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 4},
      "targets": [
        {
          "expr": "rate(opensips_requests_total{method=\"INVITE\"}[1m])",
          "legendFormat": "INVITE/sec",
          "refId": "A"
        }
      ],
      "yaxes": [
        {"format": "ops", "label": "Requests/sec"},
        {"format": "short"}
      ]
    },
    {
      "type": "graph",
      "title": "SIP Response Codes (4xx/5xx)",
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 4},
      "targets": [
        {
          "expr": "rate(opensips_replies_total{code=~\"4..\"}[1m])",
          "legendFormat": "4xx - {{code}}",
          "refId": "A"
        },
        {
          "expr": "rate(opensips_replies_total{code=~\"5..\"}[1m])",
          "legendFormat": "5xx - {{code}}",
          "refId": "B"
        }
      ],
      "yaxes": [
        {"format": "ops", "label": "Responses/sec"},
        {"format": "short"}
      ]
    },
    {
      "type": "graph",
      "title": "Active Dialogs Over Time",
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 12},
      "targets": [
        {
          "expr": "opensips_active_dialogs",
          "legendFormat": "Active Dialogs",
          "refId": "A"
        }
      ],
      "yaxes": [
        {"format": "short", "label": "Dialogs"},
        {"format": "short"}
      ]
    },
    {
      "type": "graph",
      "title": "RTPEngine Active Calls",
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 12},
      "targets": [
        {
          "expr": "rtpengine_calls_total",
          "legendFormat": "Active Calls",
          "refId": "A"
        }
      ],
      "yaxes": [
        {"format": "short", "label": "Calls"},
        {"format": "short"}
      ]
    }
  ]
}

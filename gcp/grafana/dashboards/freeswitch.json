{
  "id": null,
  "uid": "freeswitch-sbc",
  "title": "FreeSWITCH Monitoring",
  "tags": ["freeswitch", "voip"],
  "timezone": "browser",
  "schemaVersion": 27,
  "version": 0,
  "refresh": "5s",
  "panels": [
    {
      "type": "stat",
      "title": "FreeSWITCH Status",
      "gridPos": {"h": 4, "w": 6, "x": 0, "y": 0},
      "targets": [{"expr": "freeswitch_up", "refId": "A"}],
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "steps": [
              {"value": 0, "color": "red"},
              {"value": 1, "color": "green"}
            ]
          }
        }
      }
    },
    {
      "type": "stat",
      "title": "Active Calls",
      "gridPos": {"h": 4, "w": 6, "x": 6, "y": 0},
      "targets": [{"expr": "freeswitch_calls_total", "refId": "A"}]
    }
  ]
}

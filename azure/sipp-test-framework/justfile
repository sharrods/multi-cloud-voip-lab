# ============================================================================
# CODEC & RTP TESTS
# ============================================================================

# Test multiple codec scenarios
test-codecs target="127.0.0.1:5060":
    @echo "Running codec negotiation tests..."
    @just run-scenario "codec_g711" "{{target}}" "5" "30"
    @just run-scenario "codec_g729" "{{target}}" "5" "30"
    @just run-scenario "codec_opus" "{{target}}" "5" "30"
    @bash scripts/collect_stats.sh "functional" "{{TIMESTAMP}}"

# Test RTP with media
test-rtp target="127.0.0.1:5060" rate="10" calls="50":
    @echo "Running RTP media test..."
    @just run-scenario "rtp_media" "{{target}}" "{{rate}}" "{{calls}}"

# ============================================================================
# HELPER RECIPES
# ============================================================================

# Internal: Run test with stats collection
run-test scenario target rate calls result_type:
    #!/usr/bin/env bash
    set -euo pipefail
    TEST_ID="{{scenario}}_{{TIMESTAMP}}"
    LOG_DIR="{{LOGS_DIR}}/{{result_type}}/$TEST_ID"
    mkdir -p "$LOG_DIR"
    
    sipp {{target}} \
        -sf {{SCENARIOS_DIR}}/{{scenario}}.xml \
        -r {{rate}} \
        -m {{calls}} \
        -trace_msg -message_file "$LOG_DIR/messages.log" \
        -trace_screen -screen_file "$LOG_DIR/screen.log" \
        -trace_err -error_file "$LOG_DIR/error.log" \
        -trace_stat -stf "$LOG_DIR/stats.csv" \
        -trace_counts \
        -trace_rtt \
        -fd 1 \
        -timeout 60s \
        -timeout_error \
        -default_behaviors none
    
    bash scripts/parse_logs.sh "$LOG_DIR" "{{result_type}}" "{{TIMESTAMP}}"

# Internal: Run authenticated test
run-test-auth scenario target user pass result_type:
    #!/usr/bin/env bash
    set -euo pipefail
    TEST_ID="{{scenario}}_{{TIMESTAMP}}"
    LOG_DIR="{{LOGS_DIR}}/{{result_type}}/$TEST_ID"
    mkdir -p "$LOG_DIR"
    
    sipp {{target}} \
        -sf {{SCENARIOS_DIR}}/{{scenario}}.xml \
        -au {{user}} \
        -ap {{pass}} \
        -r 10 \
        -m 100 \
        -trace_msg -message_file "$LOG_DIR/messages.log" \
        -trace_screen -screen_file "$LOG_DIR/screen.log" \
        -trace_err -error_file "$LOG_DIR/error.log" \
        -trace_stat -stf "$LOG_DIR/stats.csv"
    
    bash scripts/parse_logs.sh "$LOG_DIR" "{{result_type}}" "{{TIMESTAMP}}"

# Internal: Run UAS (server mode)
run-uas scenario port result_type:
    #!/usr/bin/env bash
    TEST_ID="{{scenario}}_{{TIMESTAMP}}"
    LOG_DIR="{{LOGS_DIR}}/{{result_type}}/$TEST_ID"
    mkdir -p "$LOG_DIR"
    
    sipp -sn uas \
        -p {{port}} \
        -trace_msg -message_file "$LOG_DIR/messages.log" \
        -trace_screen -screen_file "$LOG_DIR/screen.log" \
        -trace_err -error_file "$LOG_DIR/error.log"

# Internal: Run redirect test
run-redirect-test target rate calls:
    #!/usr/bin/env bash
    set -euo pipefail
    TEST_ID="redirect_test_{{TIMESTAMP}}"
    LOG_DIR="{{LOGS_DIR}}/functional/$TEST_ID"
    mkdir -p "$LOG_DIR"
    
    # Start redirect UAS in background
    sipp -p 5070 \
        -sf {{SCENARIOS_DIR}}/redirect/redirect_uas_305.xml \
        -trace_msg -message_file "$LOG_DIR/uas_messages.log" \
        -trace_screen -screen_file "$LOG_DIR/uas_screen.log" &
    UAS_PID=$!
    
    sleep 2
    
    # Run UAC that handles redirects
    sipp {{target}} \
        -sf {{SCENARIOS_DIR}}/redirect/redirect_uac.xml \
        -r {{rate}} \
        -m {{calls}} \
        -trace_msg -message_file "$LOG_DIR/uac_messages.log" \
        -trace_screen -screen_file "$LOG_DIR/uac_screen.log" \
        -trace_err -error_file "$LOG_DIR/error.log" \
        -trace_stat -stf "$LOG_DIR/stats.csv"
    
    kill $UAS_PID 2>/dev/null || true
    bash scripts/parse_logs.sh "$LOG_DIR" "functional" "{{TIMESTAMP}}"

# Generate consolidated report
report test_type timestamp:
    @echo "Generating report for {{test_type}} - {{timestamp}}..."
    @bash scripts/generate_report.sh "{{test_type}}" "{{timestamp}}"
    @echo "Report generated: reports/{{test_type}}_{{timestamp}}.html"

# View latest report
view-report test_type:
    @bash scripts/view_report.sh "{{test_type}}"

# Archive old results
archive days="30":
    @echo "Archiving results older than {{days}} days..."
    @bash scripts/archive_results.sh "{{days}}"

# Show test statistics summary
stats:
    @bash scripts/show_stats.sh

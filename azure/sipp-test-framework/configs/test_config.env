# SIPP Test Framework Configuration
# Copy this file to configs/test_config.env and customize for your environment

# =============================================================================
# SBC/TARGET CONFIGURATION
# =============================================================================

# Default SBC target (can be overridden via command line)
DEFAULT_TARGET="127.0.0.1:5060"

# SBC IP addresses for different test scenarios
SBC_PRIMARY="10.0.1.100:5060"
SBC_SECONDARY="10.0.1.101:5060"
SBC_CLUSTER="10.0.1.100:5060,10.0.1.101:5060"

# Redirect target for 305 tests (where redirected calls should go)
REDIRECT_TARGET="10.0.2.100"
REDIRECT_PORT="5060"

# =============================================================================
# SIPP CONFIGURATION
# =============================================================================

# SIPP local IP (leave empty for auto-detect)
SIPP_LOCAL_IP=""

# SIPP local port range
SIPP_LOCAL_PORT_START="5070"
SIPP_LOCAL_PORT_END="5090"

# Transport protocol (UDP, TCP, TLS)
TRANSPORT="UDP"

# =============================================================================
# TEST PARAMETERS
# =============================================================================

# Default test duration (seconds)
DEFAULT_DURATION="60"

# Default call rate (CPS)
DEFAULT_RATE="10"

# Default number of calls
DEFAULT_CALLS="100"

# Maximum concurrent calls
MAX_CONCURRENT_CALLS="1000"

# Call duration (milliseconds)
CALL_DURATION="5000"

# =============================================================================
# CAPACITY TEST PARAMETERS
# =============================================================================

# CPS test configuration
CPS_START="10"
CPS_MAX="200"
CPS_STEP="10"
CPS_DURATION_PER_STEP="120"

# Capacity test configuration
CAPACITY_TARGET_CPS="50"
CAPACITY_DURATION="3600"
CAPACITY_MAX_CALLS="2000"

# Stress test configuration
STRESS_START_CPS="10"
STRESS_MAX_CPS="500"
STRESS_STEP="20"

# =============================================================================
# AUTHENTICATION
# =============================================================================

# SIP authentication credentials
SIP_USERNAME="testuser"
SIP_PASSWORD="testpass"
SIP_REALM="sip.example.com"

# =============================================================================
# LOGGING & REPORTING
# =============================================================================

# Enable detailed message tracing
TRACE_MSG="true"

# Enable screen output logging
TRACE_SCREEN="true"

# Enable error logging
TRACE_ERROR="true"

# Enable statistics CSV
TRACE_STATS="true"

# Enable RTT (Round Trip Time) tracking
TRACE_RTT="true"

# Log retention (days)
LOG_RETENTION_DAYS="30"

# =============================================================================
# THRESHOLDS & ALERTS
# =============================================================================

# Maximum acceptable failure rate (percentage)
MAX_FAILURE_RATE="5.0"

# Maximum acceptable response time (milliseconds)
MAX_RESPONSE_TIME="500"

# Minimum required success rate for regression tests (percentage)
MIN_SUCCESS_RATE="95.0"

# =============================================================================
# CODEC CONFIGURATION
# =============================================================================

# Supported codecs (for codec negotiation tests)
CODECS="PCMU,PCMA,G729,OPUS"

# RTP port range
RTP_PORT_START="10000"
RTP_PORT_END="20000"

# =============================================================================
# ADVANCED OPTIONS
# =============================================================================

# Enable RTP echo (for media testing)
RTP_ECHO="false"

# PCAP capture
PCAP_ENABLED="false"
PCAP_DIR="logs/pcap"

# Timeout values (milliseconds)
TIMEOUT_GLOBAL="60000"
TIMEOUT_RECV="30000"
TIMEOUT_SEND="10000"

# Error handling
ON_TIMEOUT="abort"
ON_ERROR="abort"

# =============================================================================
# NOTIFICATION CONFIGURATION
# =============================================================================

# Email notifications (set to enable)
NOTIFY_EMAIL=""
NOTIFY_ON_FAILURE="false"
NOTIFY_ON_COMPLETION="false"

# Slack webhook (optional)
SLACK_WEBHOOK=""

# =============================================================================
# ENVIRONMENT-SPECIFIC OVERRIDES
# =============================================================================

# Production environment
if [ "$TEST_ENV" = "production" ]; then
    SBC_PRIMARY="prod-sbc1.example.com:5060"
    SBC_SECONDARY="prod-sbc2.example.com:5060"
    MAX_CONCURRENT_CALLS="5000"
    NOTIFY_ON_FAILURE="true"
fi

# Staging environment
if [ "$TEST_ENV" = "staging" ]; then
    SBC_PRIMARY="staging-sbc.example.com:5060"
    MAX_CONCURRENT_CALLS="2000"
fi

# Development environment
if [ "$TEST_ENV" = "development" ]; then
    SBC_PRIMARY="127.0.0.1:5060"
    MAX_CONCURRENT_CALLS="500"
    DEFAULT_RATE="5"
fi
